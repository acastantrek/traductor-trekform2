{
  "name": "classtranslate",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @ct/api\" \"npm run dev -w @ct/web\"",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p e2e",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @ct/web",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.0.0",
    "supabase": "^2.121.0",
    "typescript": "~5.9.3"
  }
}
