{
  "name": "@ct/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=.env src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "start:ts": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "user:create": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env scripts/create-user.ts",
    "test:db": "node --env-file-if-exists=../../.env --env-file-if-exists=../web/.env --env-file-if-exists=.env ../../node_modules/vitest/vitest.mjs run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@ct/shared": "*",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "fastify": "^5.0.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.0.0",
    "vitest": "^4.0.0"
  }
}
