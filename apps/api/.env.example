# Copiar a .env en la raíz (o apps/api/.env, que tiene prioridad). Las claves solo viven en el backend (AC-09).
PORT=3001
HOST=0.0.0.0
# Orígenes permitidos (coma). En dev, Vite hace de proxy y no hace falta tocarlo.
ALLOWED_ORIGINS=http://localhost:5173

# Supabase (backend, service role). Local: valores de `npx supabase status` (API_URL, SECRET_KEY).
SUPABASE_URL=http://127.0.0.1:55621
SUPABASE_SECRET_KEY=

# Proveedores: deepgram|mock y deepl|google|mock. Si se omiten: real si hay clave (DeepL antes que Google), mock si no.
STT_PROVIDER=
TRANSLATION_PROVIDER=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Claves del plan gratuito de DeepL: terminan en ":fx".
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Ajustes de sesión
LANGUAGE_GRACE_MS=15000
MAX_STUDENTS_PER_SESSION=150
BUFFER_SIZE=50
TRANSLATION_TIMEOUT_MS=6000
